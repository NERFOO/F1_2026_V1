										else if (@d.DriverName == "Kevin Magnussen" || @d.DriverName == "Nico Hülkenberg")
										{
											<img style="background-color: #acb0b3" class="card-img-top" src="~/img/Drivers/@d.DriverImg" alt="Driver image">
										}

										<div class="card-body d-flex justify-content-between">
											<span><b>@d.DriverName</b></span>
											<span><b>$ @d.Price M</b></span>

											<form id="formDriver@(d.IdDriver)" method="post">
												@Html.AntiForgeryToken()
												<input type="hidden" name="idDriver" value="@d.IdDriver" />
												<button type="submit">
													<img style="cursor: pointer;" id="driver@(d.IdDriver)" width="24px" src="~/img/svg-icons/plusFill.svg" alt="Pick" />
												</button>
											</form>

											<form id="formDriver@(d.IdDriver)" method="post" action="RemoveUserTeamDriver">
												@Html.AntiForgeryToken()
												<input type="hidden" name="idDriverClose" value="@d.IdDriver" />
												<button type="submit">
													<img style="cursor: pointer;" id="driver@(d.IdDriver)" width="24px" class="close" src="~/img/svg-icons/close.svg" alt="Close" />
												</button>
											</form>

										</div>
									</div>
								</div>
							}
						</div>
						<div id="teamsSelection" class="card-body none" style="overflow-y: scroll;">
							@foreach (Team t in teams)
							{
								<div class="card-body d-flex justify-content-center">
									<div class="card">

										@if (@t.IdTeam == 1)
										{
											<img style="background-color: #00cab5" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 2)
										{
											<img style="background-color: #1e58be" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 3)
										{
											<img style="background-color: #ea1d23" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 4)
										{
											<img style="background-color: #218fcb" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 5)
										{
											<img style="background-color: #f47f1f" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 6)
										{
											<img style="background-color: #2a7c68" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 7)
										{
											<img style="background-color: #48728e" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 8)
										{
											<img style="background-color: #a91e35" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 9)
										{
											<img style="background-color: #35bad9" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}
										else if (@t.IdTeam == 10)
										{
											<img style="background-color: #acb0b3" class="card-img-top" src="~/img/Cars/@t.TeamImg" alt="Team image">
										}

										<div class="card-body d-flex justify-content-between">
											<span><b>@t.TeamName</b></span>
											<span><b>$ @t.Price M</b></span>
										</div>
										<div class="d-flex justify-content-center" style="margin-bottom: 20px">
										<form id="formTeam@(t.IdTeam)" method="post" action="CreateUserTeamDrivers">
											@Html.AntiForgeryToken()
												<input type="hidden" name="idTeam" value="@t.IdTeam" />
												<button type="submit" class="btn btn-outline-dark">Update Team</button>
											</form>
										</div>
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}

<script>
	var liTeam = document.getElementById("liTeam");
	var liDriver = document.getElementById("liDriver");
	
	var teamSelection = document.getElementById("teamsSelection");
	var driversSelection = document.getElementById("driversSelection");

	liTeam.addEventListener("click", function () {
		if (teamSelection.classList.contains("none")) {
			teamSelection.classList.remove("none");
			driversSelection.classList.add("none");

			teamSelection.classList.add("displayDiv");
			driversSelection.classList.remove("displayDiv");
			
			liTeam.classList.add("active");
			liDriver.classList.remove("active");
		}
	});

	liDriver.addEventListener("click", function () {
		if (driversSelection.classList.contains("none")) {
			driversSelection.classList.remove("none");
			teamSelection.classList.add("none");

			teamSelection.classList.remove("displayDiv");
			driversSelection.classList.add("displayDiv");

			liDriver.classList.add("active");
			liTeam.classList.remove("active");
		}
	});
</script>



