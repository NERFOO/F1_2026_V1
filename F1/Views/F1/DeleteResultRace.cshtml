@{
    List<Driver> drivers = ViewData["Drivers"] as List<Driver>;
    List<Race> races = ViewData["Races"] as List<Race>;

    ResultRace resultRace = ViewData["ResultRace"] as ResultRace;
}

<div style="padding: 160px 0 100px">
    <h1>Delete result race</h1>

    <form method="post">
        @Html.AntiForgeryToken()
        <label>Choose the race</label>
        <select class="form-select" name="idRace" required>
            <option value="" selected>Choose one</option>
            @foreach (Race r in races)
            {
                <option value="@r.IdRace">@r.GpName</option>
            }
        </select>

        <label>Choose the driver</label>
        <select class="form-select" name="idDriver" required>
            <option value="" selected>Choose one</option>
            @foreach (Driver d in drivers)
            {
                <option value="@d.IdDriver">@d.DriverName</option>
            }
        </select>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-danger">Delete Record</button>
            <a asp-controller="F1" asp-action="AdminPage" class="btn btn-outline-warning">Come back</a>
        </div>
    </form>

    <h4>@ViewData["ResultRaceCreation"]</h4>
</div>
